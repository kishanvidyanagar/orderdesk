rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /Hotels/{hotelId} {
      allow read, write: if request.auth != null && request.auth.uid == hotelId;
    }

    match /MenuItems/{menuItemId} {
      allow read: if request.auth != null && resource.data.hotelId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.hotelId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.hotelId == request.auth.uid && request.resource.data.hotelId == request.auth.uid;
    }

    match /Orders/{orderId} {
      allow read: if request.auth != null && resource.data.hotelId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.hotelId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.hotelId == request.auth.uid && request.resource.data.hotelId == request.auth.uid;
    }
  }
}
